{
  "rules": {
    "rooms": {
      "$room": {
        ".read": true,
        ".write": true,
        ".validate": "$room.matches(/^[0-9a-f]{64}$/) && newData.hasChildren(['v', 'updatedAt'])",
        "v": { ".validate": "newData.val() === 2" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "people": {
          "$i": {
            ".validate": "$i.matches(/^[0-9]{1,3}$/) && newData.hasChildren(['id', 'name'])",
            "id": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,32}$/)" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 30" },
            "at": { ".validate": "newData.isNumber()" },
            "$outro": { ".validate": false }
          }
        },
        "expenses": {
          "$i": {
            ".validate": "$i.matches(/^[0-9]{1,4}$/) && newData.hasChildren(['id', 'amount', 'payer', 'among'])",
            "id": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,32}$/)" },
            "desc": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "amount": { ".validate": "newData.isNumber() && newData.val() > -10000000000 && newData.val() < 10000000000" },
            "payer": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,32}$/)" },
            "among": {
              "$j": { ".validate": "$j.matches(/^[0-9]{1,2}$/) && newData.isString() && newData.val().matches(/^[a-z0-9]{1,32}$/)" }
            },
            "at": { ".validate": "newData.isNumber()" },
            "kind": { ".validate": "newData.val() === 'payment'" },
            "forgiven": { ".validate": "newData.val() === true && newData.parent().child('kind').val() === 'payment'" },
            "by": { ".validate": "newData.isString() && newData.val().length <= 30" },
            "byId": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,32}$/)" },
            "shares": {
              "$p": { ".validate": "$p.matches(/^[a-z0-9]{1,32}$/) && newData.isNumber() && newData.val() >= 0" }
            },
            "$outro": { ".validate": false }
          }
        },
        "deleted": {
          "$i": { ".validate": "$i.matches(/^[0-9]{1,3}$/) && newData.isString() && newData.val().matches(/^[a-z0-9]{1,32}$/)" }
        },
        "gone": {
          "$i": {
            ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.hasChildren(['id', 'amount'])",
            "id": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,32}$/)" },
            "desc": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "amount": { ".validate": "newData.isNumber() && newData.val() > -10000000000 && newData.val() < 10000000000" },
            "at": { ".validate": "newData.isNumber()" },
            "by": { ".validate": "newData.isString() && newData.val().length <= 30" },
            "byId": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,32}$/)" },
            "goneAt": { ".validate": "newData.isNumber()" },
            "to": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,32}$/)" },
            "lostTo": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,32}$/)" },
            "$outro": { ".validate": false }
          }
        },
        "$outro": { ".validate": false }
      }
    },
    "pix": {
      "$room": {
        "$person": {
          ".write": "!data.exists() || data.child('key').val() === '' || data.child('tok').val() === newData.child('tok').val()",
          ".validate": "$room.matches(/^[0-9a-f]{64}$/) && $person.matches(/^[a-z0-9]{1,32}$/) && newData.hasChildren(['key','tok'])",
          "key": { ".read": true, ".validate": "newData.isString() && newData.val().length <= 80" },
          "tok": { ".validate": "newData.isString()" },
          "$outro": { ".validate": false }
        }
      }
    },
    "fotos": {
      "$room": {
        ".read": true,
        ".write": true,
        ".validate": "$room.matches(/^[0-9a-f]{64}$/) && newData.isString() && newData.val().matches(/^data:image\\/jpeg;base64,[A-Za-z0-9+\\/=]+$/) && newData.val().length <= 400000"
      }
    },
    "visitas": {
      "$dia": {
        ".write": "newData.exists()",
        ".validate": "$dia.matches(/^20[0-9]{2}-[01][0-9]-[0-3][0-9]$/) && newData.isNumber() && ((!data.exists() && newData.val() === 1) || newData.val() === data.val() + 1)"
      }
    }
  }
}
